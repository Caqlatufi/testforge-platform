# TestForge local-development example. Copy to .env.local and never commit real values.

# Control plane: loopback is the secure default. Set 0.0.0.0 only on a trusted network.
TESTFORGE_SERVER_ADDRESS=127.0.0.1
TESTFORGE_SERVER_PORT=8081
TESTFORGE_CLIENT_PORT=5174
TESTFORGE_DB_URL=jdbc:mysql://127.0.0.1:3306/testforge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=testforge
MYSQL_PASSWORD=testforge_mysql
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=testforge_redis

# Jenkins. Keep the bundled development Jenkins bound to loopback.
TESTFORGE_JENKINS_BIND_ADDRESS=127.0.0.1
TESTFORGE_JENKINS_URL=http://127.0.0.1:8082
TESTFORGE_JENKINS_PUBLIC_URL=http://127.0.0.1:8082/
TESTFORGE_CICD_CALLBACK_BASE_URL=http://127.0.0.1:8081
TESTFORGE_SCM_MIRROR_URL=https://example.invalid/your/testforge-platform.git
TESTFORGE_SELFTEST_ENDPOINT=http://127.0.0.1:15174

# AI diagnosis is opt-in. Use a dedicated Codex home, never your personal ~/.codex.
TESTFORGE_AI_ENABLED=false
TESTFORGE_AI_PROVIDER=codex-cli
TESTFORGE_CODEX_COMMAND=codex
TESTFORGE_AI_CODEX_HOME=C:/replace-with-dedicated-testforge-codex-home
TESTFORGE_AI_MODEL=gpt-5.6-luna
TESTFORGE_AI_REASONING_EFFORT=high

# Object storage is optional. Values below are placeholders, not usable credentials.
TESTFORGE_OSS_ENABLED=false
TESTFORGE_OSS_ENDPOINT=https://oss.example.invalid
TESTFORGE_OSS_BUCKET=replace-with-bucket
TESTFORGE_OSS_PREFIX=testforge
TESTFORGE_OSS_ACCESS_KEY_ID=replace-with-access-key-id
TESTFORGE_OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret

# MCP runs on the user's machine and may only read this explicit workspace.
TESTFORGE_URL=http://127.0.0.1:8081
TESTFORGE_TOKEN=
TESTFORGE_WORKSPACE=C:/replace-with/authorized/project
