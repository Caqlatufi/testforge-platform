{
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "confidence", "evidence", "suggestions", "missingEvidence"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["PRODUCT_DEFECT", "SCRIPT_ERROR", "ENVIRONMENT", "WORKER_LOST", "FLAKY", "UNKNOWN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "reason"],
        "properties": {
          "evidenceId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "suggestions": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "missingEvidence": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
  }
}
