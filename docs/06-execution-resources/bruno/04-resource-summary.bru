meta {
  name: 04 Resource Summary
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/resources/summary
  body: none
  auth: none
}

tests {
  test("separates compute capacity and interactive targets", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.property("computeCapacity");
    expect(res.body.data).to.have.property("interactiveTargets");
  });
}
