meta {
  name: Diagnose Report
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/reports/{{reportId}}/diagnosis
  body: json
  auth: none
}

body:json {
  {
    "requestKey": "{{requestKey}}",
    "forceRefresh": false
  }
}

tests {
  test("returns evidence-bound structured advice", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.model).to.equal("gpt-5.6-luna");
    expect(res.body.data.reasoningEffort).to.equal("high");
    expect(res.body.data.evidence).to.be.an("array");
    expect(res.body.data.suggestions).to.be.an("array");
  });
}
