meta {
  name: Get Latest Diagnosis
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/reports/{{reportId}}/diagnosis
  body: none
  auth: none
}

tests {
  test("returns persisted diagnosis", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.reportId).to.equal(bru.getEnvVar("reportId"));
    expect(res.body.data.reused).to.equal(true);
  });
}
