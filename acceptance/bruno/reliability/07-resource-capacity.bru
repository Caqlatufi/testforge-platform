meta {
  name: Resource Capacity
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/monitoring/resources
  body: none
  auth: none
}

tests {
  test("both scheduling pools expose capacity", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.property("processCapacity");
    expect(res.body.data).to.have.property("deviceCapacity");
    expect(res.body.data).to.have.property("streamPending");
  });
}
